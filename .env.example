# Backend_Project — environment template.
#
#   cp .env.example .env   and fill in the real values.
#
# The authoritative live values are in three places, none of them this repo:
#   - Render dashboard  → the `backend-project` service's env vars (backend)
#   - GitHub Actions    → repo secrets, used by .github/workflows/*.yml (cron)
#   - Supabase dashboard → connection strings for the Meta_ads_data project
#
# Write this file BOM-free. python-dotenv silently fails to parse a BOM'd
# .env on Windows (PowerShell's Set-Content adds one) and every key comes
# back empty with no error.

# ---------------------------------------------------------------------
# Database — Supabase Postgres (project Meta_ads_data, rtkohjfzyzhizkebdsuy)
# ---------------------------------------------------------------------
# DATABASE_URL is the async (asyncpg) URL the FastAPI app uses.
# DATABASE_URL_SYNC is the psycopg2 URL alembic and scripts/ use.
# Both should point at the pooler (port 6543, transaction mode).
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:6543/postgres
DATABASE_URL_SYNC=postgresql+psycopg2://USER:PASSWORD@HOST:6543/postgres

# ---------------------------------------------------------------------
# Meta Marketing API
# ---------------------------------------------------------------------
# A System User token with ads_read on every account below.
META_ACCESS_TOKEN=
META_API_VERSION=v21.0

# Accounts are DISCOVERED by number — add META_ACCOUNT_4_ID/_NAME for a
# fourth, no code change needed (see _discover_meta_accounts in app/config.py).
# The `act_` prefix is optional; it's stripped either way.
META_ACCOUNT_1_ID=
META_ACCOUNT_1_NAME=Raho Saadaa
META_ACCOUNT_2_ID=
META_ACCOUNT_2_NAME=Fourth Ad Account - SD
META_ACCOUNT_3_ID=
META_ACCOUNT_3_NAME=Third Ad Account - SD

# Optional. META_BUSINESS_ID is REQUIRED for the business-scoped services
# (business_assets / catalogs / products) — without it they raise
# ConfigurationError rather than silently returning nothing.
META_BUSINESS_ID=
META_APP_ID=
META_APP_SECRET=

# ---------------------------------------------------------------------
# Supabase REST (silver RPCs, content register mirror) — optional
# ---------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CONTENT_WORKFLOW_URL=
CONTENT_SERVICE_KEY=

# ---------------------------------------------------------------------
# Shopify Admin API (scripts/ingest_shopify.py)
# ---------------------------------------------------------------------
SHOP_DOMAIN=
SHOP_NAME=
ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=

# ---------------------------------------------------------------------
# Instagram (scripts/ingest_instagram*.py) — one IG user per Meta account
# ---------------------------------------------------------------------
IG_USER_ID_1=
IG_USER_ID_2=
IG_USER_ID_3=
IG_USERNAME_1=
IG_USERNAME_2=

# ---------------------------------------------------------------------
# BigQuery inventory (scripts/fetch_bq_inventory_daily.py)
# ---------------------------------------------------------------------
# GOOGLE_CREDS_JSON is the full service-account JSON, on one line.
GOOGLE_CREDS_JSON=
BQ_INVENTORY_TABLE=

# ---------------------------------------------------------------------
# Assistant tab (admin/src/app/assistant) — optional
# ---------------------------------------------------------------------
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=

# ---------------------------------------------------------------------
# App / CORS
# ---------------------------------------------------------------------
# NOTE: NEXT_PUBLIC_API_BASE_URL does NOT belong in this file. Next.js
# only reads env files from its own project root, so a NEXT_PUBLIC_*
# value here is invisible to the frontend -- it falls back to the
# hardcoded default in admin/src/lib/api.ts and every request fails with
# "Failed to fetch". Put it in admin/.env.local instead, pointed at
# whatever APP_PORT below is set to.
APP_ENV=development
# Origin of the Next.js admin panel, so the browser can call /admin/analytics/*
# cross-origin. Locally that's the dev server; in prod, the Render admin URL.
ADMIN_APP_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------
# Scheduler — OFF in prod on purpose.
# ---------------------------------------------------------------------
# Render web dynos restart/scale freely; an in-process APScheduler there
# fires duplicate jobs on every cold start. Scheduled work runs from
# GitHub Actions (.github/workflows/daily-refresh.yml) instead.
SCHEDULER_ENABLED=false

# ---------------------------------------------------------------------
# Creative-asset registers (scripts/ingest_asset_sources.py)
# ---------------------------------------------------------------------
# Pooler DSNs for the two upstream Supabase projects that own the video
# and influencer registers. Read-only access is enough.
#   video      content-workflow-optimizer  npxpywozmrptzzytzdmg
#   influencer saadaa-creatorhub           xynyvbagcudjrzklwnqp
ASSET_REGISTER_DB_URL=
CREATORHUB_DB_URL=

# Graphics requisitions live in a Google Sheet, not a database.
# The sheet must be SHARED (viewer is enough) with the client_email
# inside GOOGLE_CREDS_JSON, and the Sheets API enabled on that project.
GRAPHICS_SHEET_ID=1qlz0u88IheUw9GDWXLD6X8TBP_wTEN3RbH-tRr628n0
GRAPHICS_SHEET_TAB=Performance Ad Req
# Historical graphics requisitions: same file, different tab. The tab NAME
# is used with GOOGLE_CREDS_JSON; the GID enables the credential-free CSV
# fallback, which only works if the file is shared link-viewable.
GRAPHICS_HISTORIC_TAB=
GRAPHICS_HISTORIC_SHEET_ID=17SAZ-WfyHTC8IxArSZlfqm6qKxcnqF2LJr82J9dT-_Y
GRAPHICS_HISTORIC_GID=655330043
GRAPHICS_SHEET_GID=

# --- creative asset registers (optional, cheaper than the DSNs above) ---
# historic_posts has RLS disabled, so the publishable/anon key is enough
# to mirror it -- no database password needed. Used as a fallback when
# CREATORHUB_DB_URL is unset.
CREATORHUB_REST_URL=
CREATORHUB_ANON_KEY=
# Same idea for the video asset register (content-workflow-optimizer).
ASSET_REGISTER_REST_URL=
ASSET_REGISTER_ANON_KEY=
# "Iterated Content" tab, read through the sheet's public CSV export --
# no Google service account required while the sheet stays link-viewable.
ITERATED_SHEET_ID=1sv8zcIT5gDE2e7zIC_ajsXW30VwOdn_9h8-SAJHKRg4
ITERATED_SHEET_GID=1385136722

# Shared secret EasyEcom echoes back as the `Access-Token` header on each
# webhook. Generate any long random string, paste the SAME value into
# EasyEcom's Webhook Settings, and set it here. Unset => the receiver
# rejects every call, which is the safe default for a public URL.
EASYECOM_WEBHOOK_TOKEN=

# Pull side of EasyEcom: scripts/ingest_easyecom_orders.py. The API key
# is the long-lived one from EasyEcom Settings -> API. The JWT lasts 90
# days and is SCOPED TO ONE location_key, which is the usual reason a
# sales channel looks absent. Mint both with:
#     ./.venv/bin/python scripts/mint_easyecom_jwt.py
# which writes EASYECOM_JWT here and lists every location on the account.
EASYECOM_API_KEY=
EASYECOM_JWT=
