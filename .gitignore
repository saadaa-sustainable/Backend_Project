__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.env
.env.*
!.env.example

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store

# Logs
*.log
logs/

# Alembic
alembic/versions/__pycache__/

# Ad-hoc scratch dumps (curl/probe outputs from local debugging).
# Kept out of the repo -- these files churn every session and have
# no long-term value. If a file needs to be preserved, rename it and
# move it under docs/ or exports/.
/*.json
/*.html
/scripts/_probe_*.py
/scripts/_check_*.py

# Frontend build artefacts (Next.js). node_modules is huge; .next/
# regenerates on build. Keep source + package.json only.
admin/node_modules/
admin/.next/
admin/out/

# Ad-level data exports. This repo is PUBLIC -- exports/ carries real ad
# names, spend and revenue (e.g. the 457-row Result Awaited reclassification
# from 2026-09-15). The .xlsx files already tracked here are schema/field
# references, not performance data; keep it that way.
exports/*.csv
